NODE_ENV=development
PORT=5000

# Must be a replica set (transactions). MongoDB Atlas clusters are; for a local one run `npm run dev:db` and use mongodb://127.0.0.1:27018/jewellery_erp?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27018/jewellery_erp?replicaSet=rs0

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
PASSWORD_RESET_MINUTES=30
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=0

ALLOW_PUBLIC_SIGNUP=false
TRIAL_DAYS=14
EMAIL_PROVIDER=console
LOG_LEVEL=info

STORAGE_DRIVER=local
STORAGE_DIR=storage

# Default Super Admin, created on startup only if no Super Admin exists yet.
# Must be at least 6 characters.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
# Set to true for one start to re-apply SUPER_ADMIN_PASSWORD to that account (forgotten password or lockout), then remove it.
SUPER_ADMIN_RESET_PASSWORD=false
